# ============================================================
# 公考速算智能批改系统 - 服务端环境配置文件模板
# ============================================================
# 说明：
# 1. 个人本地使用/服务端全局鉴权：可复制本文件为 .env 并填入您的 API Key；
# 2. 多用户共享/公网部署（BYOK 模式）：服务端无需配置任何 Key，使用者在手机端
#    页面右上角【⚙️ 设置】填入自己的 Key 即可，Key 仅保留在手机本地，绝不落盘持久化。
# ============================================================

# 多模态大模型 API Base URL（支持 Anthropic 原生或 OneAPI/中转代理端点）
# 默认为 Anthropic 官方端点: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 多模态大模型 API Key / Auth Token
ANTHROPIC_AUTH_TOKEN=your_api_key_here

# 默认视觉识别模型（可选，留空将自动选用最适模型）
# 示例: claude-3-5-sonnet-20241022 或 gemini-2.5-flash
ANTHROPIC_DEFAULT_MODEL=

# Web 服务端口（默认 8000）
PORT=8000
